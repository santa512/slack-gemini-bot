# Create a Slack bot token (xoxb-...) and Socket Mode app token (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=

# Optional; defaults to the current Gemini Flash model used by the example.
GEMINI_MODEL=gemini-3.8-flash

# Enable image generation and editing (may incur API charges).
IMAGE_MODEL=gemini-3.1-flash-image

